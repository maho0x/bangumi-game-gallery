{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "bangumi-steam-gallery",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bangumi-steam-gallery.ry.mk",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://bgm.tv,https://bangumi.tv,https://chii.in"
  },
  "ratelimits": [
    {
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "UPSTREAM_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
